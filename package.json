{
  "name": "agentvault-monorepo",
  "private": true,
  "version": "0.1.3",
  "license": "Apache-2.0",
  "author": "Emir Perla <emirperla96@gmail.com> (https://orcid.org/0009-0009-8515-2727)",
  "homepage": "https://we-do-care-global.github.io/agentvault/",
  "repository": {
    "type": "git",
    "url": "https://github.com/we-do-care-global/agentvault.git"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --sort build && pnpm -r --workspace-concurrency=1 --sort typecheck",
    "lint": "pnpm -r --if-present lint",
    "clean": "pnpm -r exec node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1"
  }
}